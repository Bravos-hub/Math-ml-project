# Local environments and generated Python files
.venv/
__pycache__/
*.py[cod]

# Large raw geospatial downloads; keep download/extraction scripts instead
*.nc
*.tif
*.tiff
*.zip

# Temporary notebook/runtime figures
*-ipython-tmp-*.png
2026*-ipython-tmp-*.png

# Local tool/cache directories
.mypy_cache/
.pytest_cache/
.ipynb_checkpoints/

# Runtime API caches are committed (small, reproducibility-critical);
# exceptions go here:
data/raw/climate_cache/.keep
data/raw/climate_cache/climateserv/*.json
data/raw/climate_cache/nasapower/*.json
data/interim/.aas2018_layout.txt
