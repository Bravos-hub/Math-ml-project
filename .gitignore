# Local environments and generated Python files
.venv/
__pycache__/
*.py[cod]

# Large raw geospatial downloads; keep download/extraction scripts instead
*.nc
*.tif
*.tiff
*.zip

# Temporary notebook/runtime figures
*-ipython-tmp-*.png
2026*-ipython-tmp-*.png

# Local tool/cache directories
.mypy_cache/
.pytest_cache/
.ipynb_checkpoints/

# Runtime API caches are committed (small, reproducibility-critical);
# exceptions go here:
data/raw/climate_cache/.keep
data/raw/climate_cache/climateserv/*.json
data/raw/climate_cache/nasapower/*.json
data/interim/.aas2018_layout.txt

# Generated validation and diagnostic artifacts. Curated summary tables that
# are already tracked remain versioned; these rules prevent new run-specific
# CSVs, manifests, and logs from making the worktree dirty.
reports/tables/validation_*.csv
reports/tables/*_predictions.csv
reports/tables/*_analysis_manifest.json
reports/tables/*_run.log
reports/tables/*_spatial_fold_results.csv
reports/tables/*_spatial_model_comparison.csv
!reports/tables/multi_crop_spatial_model_comparison.csv
!reports/tables/multi_crop_analysis_manifest.json
implement.txt
